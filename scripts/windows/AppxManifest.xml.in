<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX package manifest of SSHTermaq for the Microsoft Store. scripts\windows\msix.ps1 fills in @VERSION@ (x.y.z.0:
     the Store keeps the fourth part for itself). Identity and publisher: Partner Center > Product identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="PavelAKulov.SSHTermaq" Publisher="CN=76BD49D7-E79E-4C78-9119-F4F3FDD9E7FD" Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>SSHTermaq</DisplayName>
    <PublisherDisplayName>f1resh</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 10 1809: the oldest version with everything the app uses. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SSHTermaq" Executable="SSHTermaq.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="SSHTermaq" Description="PuTTY-compatible SSH client with tabs, split panes and a file manager"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <!-- Links open a tab: the link is passed on the command line, as with a second instance. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="ssh"><uap:DisplayName>SSH link</uap:DisplayName></uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="sftp"><uap:DisplayName>SFTP link</uap:DisplayName></uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="scp"><uap:DisplayName>SCP link</uap:DisplayName></uap:Protocol>
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="telnet"><uap:DisplayName>Telnet link</uap:DisplayName></uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
